PORT=3000
DATA_DIR=./data
# Optional image analysis. Keep the key server-side; disabled by default.
VISION_ENABLED=false
VISION_MODEL=gpt-4.1-mini
HOMECARE_VISION_API_KEY=

# demo: public synthetic sandbox. kakao: enforce session, staff allowlist and own-chart access.
AUTH_MODE=demo
# Real OAuth deployment: APP_ORIGIN=https://homecare-ai-demo.onrender.com
APP_ORIGIN=
# Set these privately on Render, never in source control. REST API key, not JavaScript key.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
CLINICIAN_KAKAO_IDS=
