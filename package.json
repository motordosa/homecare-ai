{
  "name": "homecare-ai-demo",
  "version": "0.2.0",
  "private": true,
  "description": "HomeCare AI patient mobile web and clinician dashboard demo with a persistent SQLite database",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "db:reset": "node --disable-warning=ExperimentalWarning lib/reset.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
